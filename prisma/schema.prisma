// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Enums
enum UserRole {
  CUSTOMER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PricingType {
  ONE_TIME
  SUBSCRIPTION
}

enum AccessType {
  LIFETIME
  SUBSCRIPTION
}

enum AccessStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum ContentType {
  FILE
  LINK
  TEXT
  VIDEO
}

enum VideoAnalysisStatus {
  PENDING
  COMPLETE
  FAILED
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

// Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  productAccess   ProductAccess[]
  purchases       Purchase[]
  videoAnalyses   VideoAnalysis[]
  serviceRequests ServiceRequest[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String    // email or user ID
  token      String    @unique
  type       TokenType
  expires    DateTime

  createdAt DateTime @default(now())

  @@unique([identifier, token, type])
  @@index([identifier])
  @@index([token])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String      @db.Text
  shortDesc   String?     @db.Text
  price       Float
  pricingType PricingType
  category    String

  // Whop integration
  whopProductId  String?
  whopCheckoutUrl String?

  // Product details (stored as JSON)
  deliverables Json? // Array of deliverable items
  features     Json? // Array of features
  requirements Json? // Array of requirements
  faq          Json? // Array of FAQ items

  // Community
  discordInviteUrl String?

  // Display
  image        String?
  featured     Boolean @default(false)
  popular      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productAccess   ProductAccess[]
  contentItems    ContentItem[]
  purchases       Purchase[]
  newsItems       NewsItem[]
  videoAnalyses   VideoAnalysis[]
  serviceRequests ServiceRequest[]

  @@index([slug])
  @@index([category])
  @@index([featured])
}

model ProductAccess {
  id         String       @id @default(cuid())
  userId     String
  productId  String
  status     AccessStatus @default(PENDING)
  accessType AccessType

  // For subscriptions
  whopMembershipId String?
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedReason    String?

  grantedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([whopMembershipId])
}

model Purchase {
  id            String         @id @default(cuid())
  userId        String
  productId     String
  amount        Float
  status        PurchaseStatus @default(PENDING)

  // Payment gateway integration
  whopPaymentId   String? @unique
  whopData        Json?   // Store full webhook payload
  paypalPaymentId String? @unique

  completedAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([whopPaymentId])
  @@index([paypalPaymentId])
}

model ContentItem {
  id          String      @id @default(cuid())
  productId   String
  type        ContentType
  title       String
  description String?     @db.Text

  // Content data
  fileUrl  String? // For FILE type (Vercel Blob URL)
  fileName String?
  fileSize Int?
  linkUrl  String? // For LINK type
  textContent String? @db.Text // For TEXT type (markdown)
  videoUrl String? // For VIDEO type (embed URL)

  // Display
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([order])
}

model WebhookLog {
  id        String   @id @default(cuid())
  event     String
  payload   Json
  processed Boolean  @default(false)
  success   Boolean?
  error     String?  @db.Text

  createdAt DateTime @default(now())

  @@index([event])
  @@index([processed])
  @@index([createdAt])
}

model NewsItem {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  productId String?
  published Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([published])
  @@index([createdAt])
}

model VideoAnalysis {
  id              String               @id @default(cuid())
  userId         String
  productId       String
  videoUrl        String
  notes           String?              @db.Text
  qualityScore    Int?
  engagementScore Int?
  recommendations Json?
  status          VideoAnalysisStatus  @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId, createdAt])
}

model ServiceRequest {
  id             String               @id @default(cuid())
  userId        String
  productId      String
  shopifyUrl     String
  notes          String?              @db.Text
  mustKeepApps   String?              @db.Text
  status         ServiceRequestStatus @default(PENDING)
  reportUrl      String?
  reportFileName String?
  adminNotes     String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId, status])
}
