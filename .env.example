# App Configuration
NEXT_PUBLIC_APP_URL=https://codecraft.techsci.xyz
NEXT_PUBLIC_SITE_NAME=TechSci CodeCraft Agency

# Database (Hostinger MySQL)
DATABASE_URL=mysql://your_db_user:your_db_pass@host:3306/your_db_name

# NextAuth.js
NEXTAUTH_URL=https://codecraft.techsci.xyz
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Resend API
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@techsci.xyz

# Whop Integration
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret
WHOP_API_KEY=your_whop_api_key
WHOP_COMPANY_ID=your_whop_company_id

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Sentry
SENTRY_DSN=your_sentry_dsn

# Admin Configuration
ADMIN_EMAIL=admin@techsci.xyz
CONTACT_EMAIL=support@techsci.xyz

# Optional: Rate Limiting (Upstash Redis)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Database Seed (required when running `bun lib/db/seed.ts`)
SEED_ADMIN_PASSWORD=your_admin_password
SEED_CUSTOMER_PASSWORD=your_test_customer_password
